# Copied to .env.production for a Pages build (docs/DEPLOY.md). The dev defaults point at the Node host.
# The live room is neochina. This placeholder is not that room.
VITE_WS_URL=wss://meltdown-match.<account>.workers.dev
VITE_LEDGER_URL=https://meltdown-match.<account>.workers.dev
VITE_CAMPAIGN_WS=wss://meltdown-campaign.<account>.workers.dev
VITE_CAMPAIGN_URL=https://meltdown-campaign.<account>.workers.dev
VITE_COUNTER_URL=https://meltdown-counter.<account>.workers.dev
VITE_PUBLIC_ROOM=lethe
# WalletConnect project id from Reown. 32 hex characters. Leave empty until one is pasted.
# A build with this empty still ships. The button says WALLETCONNECT HAS NO PROJECT ID ON THIS BUILD.
VITE_WALLETCONNECT_PROJECT_ID=
