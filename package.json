{
  "name": "meltdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MELTDOWN — browser multiplayer FPS set in Lethe, the city that forgets you.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "probe": "tsx probe/stage1.ts",
    "verify": "npm run typecheck && npm run test && npm run probe"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.180.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.13",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
